# PGM pixels are raw bytes. A lone 0x0A must not be rewritten as CRLF.
*.pgm binary

# Sources and scripts stay LF so WSL bash and gcc see the same text.
*.c            text eol=lf
*.h            text eol=lf
*.py           text eol=lf
*.sh           text eol=lf
*.md           text eol=lf
Makefile       text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
